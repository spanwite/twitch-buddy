{
	"name": "twitch-buddy",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "NODE_ENV=development bun src/main.ts",
		"build": "bun build src/main.ts --minify --outdir=dist --target=bun",
		"start": "bun dist/main.js",
		"check": "bunx biome check --write ./src",
		"format": "bunx biome format --write ./src",
		"typecheck": "tsc --noEmit",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.1.2",
		"@faker-js/faker": "^10.1.0",
		"@types/bun": "latest",
		"@types/node-telegram-bot-api": "^0.64.12",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"bottleneck": "^2.19.5",
		"node-telegram-bot-api": "^0.66.0",
		"winston": "^3.17.0",
		"zod": "^4.1.12"
	},
	"lint-staged": {
		"*.ts": [
			"biome check --write"
		]
	}
}
